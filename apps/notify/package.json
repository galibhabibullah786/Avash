  },
  "devDependencies": {
    "@avash/eslint-config": "workspace:*",
    "@inngest/test": "1.0.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3"
  }
