{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "build:node": "esbuild server/node-server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-node/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@avash/geo": "workspace:*",
    "@avash/logger": "workspace:*",
    "@avash/security": "workspace:*",
    "@avash/types": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/redis": "^1.38.4",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@avash/eslint-config": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  }
}
