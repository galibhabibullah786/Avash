# The nginx restatement of apps/web/public/_headers (§7.4), which only
# Cloudflare Pages reads.
#
# This is `include`d in every location that sets its own add_header,
# because nginx DROPS all inherited add_header directives as soon as a
# location adds one of its own. Omitting the include from a new location
# silently removes every security header from that path.
#
# __API_ORIGIN__ is substituted at build time with VITE_PUBLIC_API_BASE_URL,
# so connect-src always names the exact origin the bundle was compiled to
# call. No Gemini domain appears here — the browser never calls Gemini
# directly. img-src additionally allows the OSM tile host (ADR-013,
# MAP_TILE_URL_TEMPLATE) since raster tiles are <img> requests, not
# connect-src traffic — kept identical to apps/web/public/_headers.
# script-src/frame-src name Cloudflare Turnstile's widget script and the
# iframe it renders into.
#
# __SUPABASE_ORIGIN__ / __SUPABASE_WS_ORIGIN__ are substituted from
# VITE_PUBLIC_SUPABASE_URL the same way, rather than hardcoding the hosted
# project. The hardcoded value was correct for a deployed build and wrong
# for every other target: under ADR-014 the local stack is
# `http://127.0.0.1:54321`, and a CSP naming only the hosted origin blocks
# every auth call and every Realtime socket the moment you point the app
# at it — as a console CSP violation, not an application error, so the
# page just silently fails to sign anyone in.
#
# The ws origin is the http(s) origin with the scheme swapped, which is
# what supabase-js derives for Realtime.

add_header Content-Security-Policy "default-src 'self'; connect-src 'self' __API_ORIGIN__ __SUPABASE_ORIGIN__ __SUPABASE_WS_ORIGIN__ https://api.cloudinary.com; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://res.cloudinary.com;" always;
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "geolocation=(self), notifications=(self)" always;
