node_modules
dist
dist-node
.turbo
*.log

# Vitest coverage output (docs/standards/testing.md § Coverage)
coverage/

# pnpm content-addressable store, when it lands inside the repo instead of
# the global location (e.g. a container with no writable global XDG dir).
.pnpm-store

# Local environment files — NEVER commit real values (R2, §7.1).
# Only the committed *.example templates are tracked.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler local dev cache (apps/api)
.wrangler/

# Supabase CLI local link cache (`supabase link`, packages/db/scripts/push-hosted.mjs)
**/supabase/.temp/

# Playwright — every workspace using @playwright/test (apps/web, apps/api,
# packages/logger, and any package/app added later) generates these at
# the same relative paths.
test-results/
playwright-report/
playwright/.cache/
.secrets

# Temporary files generated by the build process or by editors
# or by the agent itself. These are never (and should never be) tracked.
temp/*
tmp/*

# Impeccable local runtime & session caches
.impeccable/config.local.json
.impeccable/live/sessions/
