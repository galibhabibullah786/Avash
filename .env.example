# Repo root — Scheduled job, ML & Monorepo Environment Template
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is the
# only tracked copy and must never contain a real secret value (R2).
#
# Quick setup:
#   cp .env.example .env
#   pnpm env:sync:dev   # Synchronizes apps/web/.env and apps/api/.dev.vars for local dev
#   pnpm env:sync:prod  # Synchronizes apps/web/.env and apps/api/.dev.vars for production
#
# R2 Enforcement: Every key below is SERVER-ONLY or LOCAL-ONLY, except for
# variables explicitly prefixed with VITE_PUBLIC_ at the bottom. Non-public
# keys are strictly blocked from reaching apps/web/.env.

# ==============================================================================
# 1. Supabase Core & Auth
# ==============================================================================
# Development: Local Supabase CLI (http://127.0.0.1:54321) or hosted dev project.
# Production: Real Supabase project (https://<project-ref>.supabase.co).
# The service-role key bypasses RLS — used by backend jobs/APIs.
SUPABASE_URL=
SUPABASE_PROJECT_REF= # e.g. kdklmbqkczkaakgswlix or local
SUPABASE_SERVICE_ROLE_KEY=

# HS256 JWT secret used by apps/api to verify Supabase-issued tokens locally (ADR-009).
# Supabase Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# ==============================================================================
# 2. AI & Weather Ingestion
# ==============================================================================
# OpenWeatherMap API key for weather data ingest (scripts/jobs/weather-ingest.ts).
OPENWEATHERMAP_API_KEY=

# Google Gemini API key for symptom triage and report classification.
GEMINI_API_KEY=

# ==============================================================================
# 3. Web Push & VAPID Keys
# ==============================================================================
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY matches VITE_PUBLIC_VAPID_PUBLIC_KEY.
# VAPID_PRIVATE_KEY is server-only and must NEVER be exposed to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==============================================================================
# 4. Database Infrastructure (Local & Hosted)
# ==============================================================================
# Disposable PostGIS container in compose.yaml (ADR-011).
# Default: postgresql://postgres:postgres@127.0.0.1:54322/avash
DATABASE_URL_LOCAL=postgresql://postgres:postgres@127.0.0.1:54322/avash
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=avash
POSTGRES_PORT=54322

# Hosted database connection string (Supabase pooler).
# Used ONLY for manual operations with --hosted flag (e.g. pnpm db:seed -- --hosted).
# Leave blank day-to-day.
DATABASE_URL_HOSTED=

# ==============================================================================
# 5. Rate Limiting & Anti-Abuse (Upstash & Turnstile)
# ==============================================================================
# Upstash Redis REST credentials for sliding-window rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile SECRET key (server-side verification).
# Dev test secret (always passes): 1x0000000000000000000000000000000AA
# Production: Real secret from Cloudflare dashboard.
TURNSTILE_SECRET_KEY=

# ==============================================================================
# 6. Media Storage (Cloudinary Direct-to-Cloud Uploads)
# ==============================================================================
# Cloudinary server credentials used to sign upload requests (ADR-015).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# 7. Environment & CORS Networking Configuration
# ==============================================================================
# Runtime environment: 'development' | 'preview' | 'production'
ENVIRONMENT=development

# CORS Allow-list: Comma-separated list of origins permitted to call apps/api.
#
# Development defaults (must include Vite dev server & Docker web container):
#   https://avash.pages.dev,http://localhost:5173,http://localhost:4173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8080
#
# Production default:
#   https://avash.pages.dev
CORS_ALLOWED_ORIGINS=https://avash.pages.dev,http://localhost:5173,http://localhost:4173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8080

# Bare suffix for PR preview subdomains (e.g. <branch>.avash.pages.dev)
CORS_PREVIEW_ORIGIN_SUFFIX=avash.pages.dev

# ==============================================================================
# 8. Notifications & Background Workers
# ==============================================================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ANNOUNCEMENT_WEBHOOK_SECRET=

# ==============================================================================
# 9. Client-Side Public Variables (apps/web & Docker build args)
# ==============================================================================
# STRICTLY VITE_PUBLIC_* ONLY. Everything in this section is compiled into the
# frontend bundle and is publicly inspectable in client JavaScript.

# API Base URL:
# Dev: http://localhost:8787
# Prod: https://avash.pages.dev (or custom API domain)
VITE_PUBLIC_API_BASE_URL=http://localhost:8787

# Supabase public credentials
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile SITE key (widget render only)
# Dev test site key (always passes): 1x00000000000000000000AA
# Production: Real site key from Cloudflare dashboard
VITE_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push public VAPID key (same as VAPID_PUBLIC_KEY above)
VITE_PUBLIC_VAPID_PUBLIC_KEY=
