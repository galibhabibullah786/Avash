# Repo root — scheduled job & ML environment (docs/PROJECT_PLAN.md §7.1)
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is the
# only tracked copy and must never contain a real value (R2).
#
#   cp .env.example .env
#
# Consumed ONLY when running the background jobs and ML scripts locally:
#   pnpm db:seed
#   pnpm tsx scripts/jobs/weather-ingest.ts
#   pnpm tsx scripts/jobs/news-scan.ts
#   python ml/serving/predict.py
#
# In production these same values are GitHub Actions secrets, injected as
# ephemeral env vars into the runner (ADR-007) — jobs talk to Supabase
# directly and are never exposed as an HTTP endpoint on apps/api (R7).
#
# Every key below is SERVER-ONLY or LOCAL-ONLY, with one documented
# exception: the VITE_PUBLIC_* block at the end, which exists solely so
# Docker Compose can pass published values to the web image as build args.
# This file is never read by apps/web at dev time (see
# apps/web/.env.example) or by apps/api (see apps/api/.dev.vars.example).
# Docker Compose also reads it when interpolating compose.yaml (see
# docs/docker.md).

# Supabase project URL and service-role key. The service-role key fully
# bypasses Row Level Security — jobs need it to write ingested data.
SUPABASE_URL=
SUPABASE_PROJECT_REF= # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenWeatherMap — weather feature ingestion (scripts/jobs/weather-ingest.ts).
OPENWEATHERMAP_API_KEY=

# Google Gemini — news article classification (scripts/jobs/news-scan.ts).
GEMINI_API_KEY=

# VAPID keypair for Web Push delivery from ml/serving/predict.py.
# VAPID_PUBLIC_KEY is the same value as the client's
# VITE_PUBLIC_VAPID_PUBLIC_KEY; the private half never reaches any
# deployed app and exists only here and in GitHub Actions secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Local Docker infrastructure (ADR-011) — LOCAL-ONLY, not secrets ---
#
# These address the disposable PostGIS container in compose.yaml, which is
# bound to 127.0.0.1 and holds nothing but seed data. Every one has a
# working default, so `pnpm docker:db` runs with all of them left blank —
# set them only to override. No deployed environment ever reads them.
# See docs/docker.md.

# Connection string for migration/seed tooling pointed at the container.
# Default target: postgresql://postgres:postgres@127.0.0.1:54322/avash
DATABASE_URL_LOCAL=

# Optional overrides for the container's own defaults
# (postgres / postgres / avash / 54322).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- Hosted database, one-off manual ops — SERVER-ONLY, a real secret ---
#
# Postgres connection string for a real Supabase project (Dashboard →
# Project Settings → Database → Connection string). Deliberately a
# separate variable from DATABASE_URL_LOCAL so leaving it set can never
# silently redirect a plain `pnpm db:seed` at a hosted database — it is
# only read when a script is passed --hosted:
#   pnpm db:seed -- --hosted
#   pnpm --filter @avash/db run db:push:hosted <project-ref>   (migrations; supabase CLI, ignores this var)
# Leave blank day-to-day. Fill in only while doing manual hosted ops,
# then blank it again — see docs/security/secrets-matrix.md § 9a and
# docs/manual-deploy.md § Service 3.
DATABASE_URL_HOSTED=

# --- apps/api container runtime env (ADR-012) — SERVER-ONLY, real secrets ---
#
# Only read when running the api image (`pnpm docker:apps`). `pnpm dev`
# uses `wrangler dev`, which reads apps/api/.dev.vars instead and ignores
# every one of these.
#
# The same duplication constraint as the VITE_PUBLIC_ block below applies:
# Compose interpolates only this root file, and .dockerignore keeps
# `**/.dev.vars` out of every build context — so the container cannot read
# apps/api/.dev.vars. compose.yaml forwards each of these into the api
# service as a RUNTIME env var (never a build arg — a secret passed as a
# build arg is baked into image history permanently, §7.1).
#
# Leaving any of these blank does not degrade gracefully. An empty
# TURNSTILE_SECRET_KEY 403s every breeding-site submission and an empty
# UPSTASH_* pair 429s every symptom check and report, because both guards
# fail closed by design (packages/security/rateLimit.ts). The container
# names the unset ones on startup — read that log first when a write path
# fails in Docker but works under `pnpm dev`.

# HS256 secret used to verify Supabase-issued JWTs (ADR-009). Same value
# as apps/api/.dev.vars; Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Upstash Redis REST credentials — sliding-window rate limiting (§7.3)
# and the Gemini daily quota guard. Both guards fail closed: unreachable
# Redis means every guarded write returns 429, never an unlimited pass.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile SECRET key — server-side verification of the token
# the widget produces from VITE_PUBLIC_TURNSTILE_SITE_KEY below. The two
# must be the two halves of the SAME Turnstile widget, or every
# verification fails with `invalid-input-response`.
TURNSTILE_SECRET_KEY=

# CORS allow-list for the api container. Must include the origin the web
# container is actually served from (http://localhost:8080 by default) or
# the browser rejects every request from it. Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=https://avash.pages.dev,http://localhost:8080,http://localhost:5173,http://localhost:4173
CORS_PREVIEW_ORIGIN_SUFFIX=

# Environment label surfaced by GET /health.
ENVIRONMENT=development

# Cloudinary — signs direct-to-Cloudinary uploads server-side (ADR-015).
# Same values as apps/api/.dev.vars; Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- apps/web build args (ADR-012) — PUBLIC, compiled into the bundle ---
#
# Only needed to build the web container image (`pnpm docker:apps:build`);
# `pnpm dev` reads apps/web/.env instead and ignores these.
#
# Two constraints make the duplication unavoidable: Compose interpolates
# only this root file, and .dockerignore keeps `**/.env` out of every
# build context — so the image cannot read apps/web/.env at build time.
# compose.yaml forwards each of these to apps/web/Dockerfile as a build
# arg, which fails the build if any required one is empty.
#
# These are the SAME published values as in apps/web/.env — anyone who
# loads the site can read them out of the bundle. Nothing server-only may
# be added to this block; a secret passed as a build arg is baked into
# image history permanently (§7.1).
VITE_PUBLIC_API_BASE_URL=http://localhost:8787
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=
VITE_PUBLIC_TURNSTILE_SITE_KEY=
VITE_PUBLIC_VAPID_PUBLIC_KEY=
